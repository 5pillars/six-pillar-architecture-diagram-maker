{
  "name": "six-pillars-inventory-cdk",
  "version": "1.0.0",
  "private": true,
  "description": "CDK app that builds the CloudFormation template for the 6pillars.ai inventory scan",
  "scripts": {
    "synth": "cdk synth --quiet",
    "build-template": "cdk synth --quiet && node scripts/copy-template.js",
    "publish-template": "scripts/publish-template.sh"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "aws-cdk": "2.1147.0",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "aws-cdk-lib": "2.275.0",
    "constructs": "10.8.1"
  }
}
